rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // Chat attachments: allow authenticated users to upload and read
    match /chat-attachments/{missionId}/{fileName} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }

    // Profile pictures: allow users to upload their own profile pictures (max 5MB)
    match /profile-pictures/{userId}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;
      allow read: if request.auth != null;
    }

    // Consent form: allow anyone to download the consent form PDF
    match /assets/{fileName} {
      allow read: if true;
    }

    // Consent uploads: allow authenticated users and admins to upload and read consent files
    match /consents/{missionId}/{userId}/{fileName} {
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == "admin");
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == "admin");
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
