rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles - users can read their own profile, admins can manage all users
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && 
        (request.auth.uid == userId || 
         request.auth.token.role == "admin" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    // Allow open read access for development
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Allow create or read in Missions (Projects/Proposals)
    match /Missions/{missionId}{
      allow read: if request.auth != null;
      allow create, update, delete: if
        request.auth != null &&
        (
          request.auth.token.role == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        );
      
      // Allow authenticated users to join as volunteers
      match /volunteer/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth != null && 
          (request.auth.uid == userId || 
           request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      }
      
      // Tasks subcollection
      match /task/{taskId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null &&
          (request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");

        // Participants subcollection - users can enroll themselves
        match /participants/{userId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update, delete: if request.auth != null && 
            (request.auth.uid == userId || 
             request.auth.token.role == "admin" ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
        }
      }

      // Attendees subcollection - users can record their own attendance
      match /attendees/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth != null && 
          (request.auth.uid == userId || 
           request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      }
    }

    // Allow authenticated users to write to activityJournals
    match /activityJournals/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Proposal collection - authenticated users can create proposals
    match /proposal/{proposalId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.proponent ||
         request.auth.token.role == "admin" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      allow delete: if request.auth != null &&
        (request.auth.token.role == "admin" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");

      // Details subcollection
      match /details/{detailId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null &&
          (request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
        allow delete: if request.auth != null &&
          (request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      }
    }
  }
}
