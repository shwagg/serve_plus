rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles - users can read their own profile, admins/sysadmins can manage all users
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null &&
        (request.auth.uid == userId ||
         request.auth.token.role == "admin" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin");

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin" ||
          request.resource.data.type in [
            "proposal_submitted",
            "proposal_status",
            "reflection_approved",
            "reflection_needs_revision",
            "badge_earned"
          ]
        );
      }

      // Global announcement read tracking
      match /globalAnnouncementReads/{readId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Rewards subcollection
      match /rewards/{rewardId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Badges subcollection — users can write their own; admins/sysadmins can write for any user
      match /badges/{badgeId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
        );
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
        );
      }
    }

    // Settings collection - admins and sysadmins can manage platform settings (agreements, etc.)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
      );
    }

    // Audit Logs — any authenticated user can create; only admin/sysadmin can read
    match /auditLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
      );
      allow update, delete: if false;
    }

    // Announcements — admin/sysadmin can post and delete; any authenticated user can read
    match /adminAnnouncements/{announcementId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
      );
      allow update: if false;
    }

    // System config (banner, etc.) — admin/sysadmin can write; public read
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
      );
    }

    // Login attempt records — written by Cloud Functions (service account bypasses rules)
    // Only admin/sysadmin should read these via AuditLogs
    match /loginAttempts/{email} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
      );
      allow write: if false; // Cloud Functions use Admin SDK, bypasses this
    }

    // Fallback — allow read on anything not explicitly covered above
    // Write is denied unless a specific rule above grants it
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Support tickets — any authenticated user can submit; only owner + admins/sysadmins can read/reply
    match /support/{ticketId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.submittedBy ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
      );

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/support/$(ticketId)).data.submittedBy ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
        );
        allow create: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/support/$(ticketId)).data.submittedBy ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
        );
      }
    }

    // Allow create or read in missions (Projects/Proposals)
    match /missions/{missionId}{
      allow read: if request.auth != null;

      // Allow authenticated users to create proposals
      allow create: if request.auth != null;

      // ADMIN / SYSADMIN - can update and delete
      allow update, delete: if
        request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin"
        );

      // PROPOSAL CREATOR - can update their own proposal only while it's still 'for_approval' (not yet reviewed)
      allow update: if
        request.auth != null &&
        request.auth.uid == resource.data.createdBy &&
        resource.data.status == 'for_approval';

      // FACULTY - can update approval chain fields (reviewedBy, recommendedBy) and nested approvals map
      allow update: if
        request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "faculty" &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewedBy', 'recommendedBy', 'status', 'lastApprovedAt', 'lastApprovedBy', 'rejectionReason', 'rejectedBy', 'rejectedAt', 'rejectedByUser', 'approvals'])
        );

      // PARTNER - can update only the approvals field (partner approval decision)
      allow update: if
        request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "partner" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvals', 'status']);
      
      // Allow authenticated users to join as volunteers
      match /volunteer/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth != null &&
          (request.auth.uid == userId ||
           request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "sysadmin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "faculty");
      }
      
      // Tasks subcollection
      match /task/{taskId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null &&
          (request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");

        // Participants subcollection - users can enroll themselves
        match /participants/{userId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update, delete: if request.auth != null && 
            (request.auth.uid == userId || 
             request.auth.token.role == "admin" ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
        }

        // Groups subcollection - for grouped tasks
        match /group/{groupId} {
          allow read: if request.auth != null;
          allow create, update: if request.auth != null;
          allow delete: if request.auth != null &&
            (request.auth.token.role == "admin" ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");

          // Members subcollection - users can join groups
          match /members/{userId} {
            allow read: if request.auth != null;
            allow create: if request.auth != null && request.auth.uid == userId;
            allow update, delete: if request.auth != null &&
              (request.auth.uid == userId ||
               request.auth.token.role == "admin" ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
          }
        }
      }

      // Attendees subcollection - users can record their own attendance
      match /attendees/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth != null && 
          (request.auth.uid == userId || 
           request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      }

      // Chat subcollection - messages only, participants determined from volunteer/faculty/partner subcollections
      match /chat/{messageId} {
        allow read: if request.auth != null;
        
        // Allow admins to create/update metadata (_meta document)
        allow create, update: if messageId == "_meta" && request.auth != null &&
          (request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
        
        // Allow any authenticated user to send messages (messageId != "_meta")
        // Add participant validation using volunteer/faculty/partner subcollections
        allow create: if messageId != "_meta" && request.auth != null;
        
        // Only admins can delete messages
        allow delete: if request.auth != null &&
          (request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      }

      // Pre-Activity Survey subcollection - users can submit their own survey
      match /volunteer/{userId}/preSurvey/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId;
      }

      // Post-Activity Survey subcollection - users can submit their own survey
      match /volunteer/{userId}/postSurvey/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId;
      }

      // Community Feedback Form subcollection - submitted by multiple partners
      match /feedbackResponses/{responseId} {
      allow create: if true;
      allow read: if false;
      allow update, delete: if false;
    }
    }

    // userMissions reverse index — users manage their own enrolled missions
    match /userMissions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      match /missions/{missionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null &&
          (request.auth.uid == userId ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      }
    }

    // Allow authenticated users to write to activityJournals
    match /activityJournals/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Proposal collection - authenticated users can create proposals
    match /proposal/{proposalId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.proponent ||
         request.auth.token.role == "admin" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      allow delete: if request.auth != null &&
        (request.auth.token.role == "admin" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");

      // Details subcollection
      match /details/{detailId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null &&
          (request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
        allow delete: if request.auth != null &&
          (request.auth.token.role == "admin" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");

           
      }
    }
    // Certificates subcollection under users - admins can manage, users can read their own
    match /users/{userId}/certificates/{certificateId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
      allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
  }
}
